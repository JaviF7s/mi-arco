rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'javi@miarco.app';
    }
    // App sin inicio de sesion: el espacio de Javi queda abierto.
    match /usuarios/javi {
      allow read, write: if true;
      match /{rest=**} {
        allow read, write: if true;
      }
    }
    // Cuentas con inicio de sesion (para cuando se vuelva a activar).
    match /usuarios/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if request.auth != null && request.auth.uid == uid;
      match /{rest=**} {
        allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }
    match /{coleccion}/{docId} {
      allow read, write: if isAdmin() && coleccion in ['perfil', 'partidos', 'companeros'];
    }
  }
}
